{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	    "source": "~/.config/fastfetch/lucy.jpg",
	    "type": "kitty",
	    "height": 8,
	    "padding": {
		    "top": 1
	    }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
	"break",
	"title",
        {
            "type": "os",
	    "key": " ",
            "keyColor": "35",
        },
        {
            "type": "kernel",
	    "key": " ",
            "keyColor": "35",
        },
	{
            "type": "shell",
            "key": " ",
            "keyColor": "35",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
	    "key": " ",
            "keyColor": "35",  
        },
        {
            "type": "uptime",
	    "format": "{2}h {3}m",
	    "key": " ",
            "keyColor": "35",
        },
	{
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "35",
        },
        {
            "type": "player",
            "key": " ",
            "keyColor": "35",
        },
        "break",
    ]
}
